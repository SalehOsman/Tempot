{
  "name": "tembot-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Sovereign Domain-Agnostic Omnichannel Modular Monolith Template & Starter Kit",
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "server:dev": "pnpm --filter @tembot/app-server dev",
    "bot:dev": "pnpm --filter @tembot/app-bot dev",
    "dashboard:dev": "pnpm --filter @tembot/app-dashboard dev",
    "tma:dev": "pnpm --filter @tembot/app-tma dev",
    "tunnel": "npx ngrok start --all --config ./ngrok.yml",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "build": "turbo run build",
    "test": "vitest run",
    "test:integration": "turbo run test:integration",
    "typecheck": "turbo run typecheck",
    "check:biome": "biome check .",
    "check:i18n": "node tooling/scripts/verify-no-hardcoded-strings.mjs",
    "check:docs": "node tooling/scripts/verify-docs.mjs",
    "format:biome": "biome format --write .",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:studio": "turbo run db:studio",
    "module:create": "plop --plopfile ./tooling/plop/plopfile.mjs module",
    "slice:create": "plop --plopfile ./tooling/plop/plopfile.mjs slice"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "plop": "^4.0.1",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
