# =============================================================================
# Tempot - Environment Variables Reference
# =============================================================================
# Instructions:
#   1. Copy this file to .env.
#   2. Fill the required values for your local, staging, or production runtime.
#   3. Never commit .env because it contains secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Section 0 - Bot Instance Identity and Local Docker
# -----------------------------------------------------------------------------

# Docker Compose project name used to isolate containers, networks, and volumes.
# Keep it unique per bot when running multiple bots on the same Docker host.
# Use lowercase letters, digits, dashes, or underscores.
COMPOSE_PROJECT_NAME=tempot

# Local host ports. Change these when another bot or local service already uses
# the same port on this machine.
BOT_HTTP_HOST_PORT=3000
POSTGRES_HOST_PORT=5432
RESTORE_POSTGRES_HOST_PORT=5433

# Local Docker database defaults. Change passwords for staging or production.
POSTGRES_USER=tempot
POSTGRES_PASSWORD=tempot_password
POSTGRES_DB=tempot_db
RESTORE_POSTGRES_USER=tempot
RESTORE_POSTGRES_PASSWORD=tempot_password
RESTORE_POSTGRES_DB=tempot_restore_db

# -----------------------------------------------------------------------------
# Section 1 - Core System
# -----------------------------------------------------------------------------

# Telegram Bot token from @BotFather.
BOT_TOKEN=

# PostgreSQL connection string.
DATABASE_URL=

# Redis connection string.
REDIS_URL=

# Comma-separated Telegram user IDs that receive the SUPER_ADMIN role.
SUPER_ADMIN_IDS=

# Bot operation mode: polling or webhook.
BOT_MODE=

# Required when BOT_MODE is webhook.
WEBHOOK_URL=
WEBHOOK_SECRET_TOKEN=
TEMPOT_READINESS_TOKEN=

# Optional trusted proxy client IP header for HTTP webhook rate limiting.
# Leave empty unless all webhook traffic reaches the app through that proxy.
# Allowed values: cf-connecting-ip or x-real-ip.
TEMPOT_HTTP_TRUSTED_CLIENT_IP_HEADER=

# Node runtime environment.
NODE_ENV=

# -----------------------------------------------------------------------------
# Section 2 - Internationalization and Region
# -----------------------------------------------------------------------------

# Primary language: ar or en.
DEFAULT_LANGUAGE=

# Default country using ISO 3166-1 alpha-2.
DEFAULT_COUNTRY=

# Regional mode: static or dynamic.
REGIONAL_MODE=

# -----------------------------------------------------------------------------
# Section 3 - AI Provider and Embeddings
# -----------------------------------------------------------------------------

# Legacy AI provider selector.
AI_PROVIDER=

# Runtime AI chat provider selector used by ai-core: gemini, openai, or deepseek.
TEMPOT_AI_PROVIDER=

# Embedding provider selector: gemini, openai, or ollama.
AI_EMBEDDING_PROVIDER=

# Embedding model. Changing this requires re-indexing existing embeddings.
# Gemini example: gemini-embedding-2-preview.
# OpenAI example: text-embedding-3-large.
AI_EMBEDDING_MODEL=

# Embedding vector dimensions. Must match AI_EMBEDDING_MODEL.
AI_EMBEDDING_DIMENSIONS=

# Gemini provider keys.
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenAI provider key.
OPENAI_API_KEY=

# DeepSeek chat provider key. Used only when chat provider is deepseek.
DEEPSEEK_API_KEY=

# Ollama local embedding endpoint. Use host.docker.internal when the bot runs in
# Docker Desktop and Ollama runs directly on the Windows host.
OLLAMA_BASE_URL=

# Help assistant RAG retrieval threshold. Leave empty for provider-aware
# defaults: Ollama uses 0.35, hosted providers use 0.70.
TEMPOT_HELP_RAG_CONFIDENCE_THRESHOLD=

# Maximum chunks allowed for a one-step bot-side knowledge write. Keep the
# default conservative so large full-project indexing does not starve bot UX.
TEMPOT_KNOWLEDGE_MAX_WRITE_CHUNKS=500

# -----------------------------------------------------------------------------
# Section 4 - Pluggable Architecture Feature Flags
# -----------------------------------------------------------------------------

# Core packages.
TEMPOT_AUTH=
TEMPOT_SESSIONS=
TEMPOT_NOTIFIER=
TEMPOT_LOGGER=
TEMPOT_AUDIT=
TEMPOT_AI=
TEMPOT_PRIVACY=
TEMPOT_STORAGE=
TEMPOT_BACKUP=
TEMPOT_DASHBOARD=
TEMPOT_REGIONAL=

# Optional packages.
TEMPOT_INPUT=
TEMPOT_DYNAMIC_CMS=
TEMPOT_SEARCH=
TEMPOT_DOCUMENTS=
TEMPOT_IMPORT=
TEMPOT_MINI_APPS=
TEMPOT_SENTRY=
TEMPOT_PAYMENT=

# -----------------------------------------------------------------------------
# Section 5 - Observability
# -----------------------------------------------------------------------------

SENTRY_DSN=
LOG_LEVEL=

# -----------------------------------------------------------------------------
# Section 6 - Storage Engine
# -----------------------------------------------------------------------------

# Active storage provider: local, google-drive, or s3.
STORAGE_PROVIDER=

# Local storage path.
STORAGE_LOCAL_PATH=

# -----------------------------------------------------------------------------
# Section 6A - Backup Management
# -----------------------------------------------------------------------------

# Encrypted backup artifact directory inside the bot runtime.
TEMPOT_BACKUP_STORAGE_PATH=

# Dedicated isolated restore rehearsal database URL. Must not match DATABASE_URL.
TEMPOT_BACKUP_RESTORE_DATABASE_URL=

# Restored file rehearsal output path inside the bot runtime.
TEMPOT_BACKUP_RESTORE_FILES_PATH=

# Optional dedicated backup encryption key. Falls back to protected-data keys.
TEMPOT_BACKUP_ENCRYPTION_KEY=

# Time zone used in generated backup filenames.
TEMPOT_BACKUP_FILENAME_TIME_ZONE=UTC

# Stale pending/running backup jobs older than this value are failed before retry.
TEMPOT_BACKUP_ACTIVE_JOB_STALE_AFTER_MS=900000

# Prisma working directory used by restore/reset migration execution.
TEMPOT_BACKUP_PRISMA_WORKING_DIRECTORY=

# Google Drive storage.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# AWS S3 or S3-compatible storage.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# -----------------------------------------------------------------------------
# Section 7 - Payment Core
# -----------------------------------------------------------------------------

PAYMENT_PROVIDER_TELEGRAM=
PAYMENT_PROVIDER_STRIPE=
PAYMENT_PROVIDER_PAYPAL=

# Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Section 8 - Protected Data Encryption
# -----------------------------------------------------------------------------

PROTECTED_DATA_ACTIVE_ENCRYPTION_KEY_VERSION=
PROTECTED_DATA_ENCRYPTION_KEYS=
PROTECTED_DATA_ACTIVE_LOOKUP_KEY_VERSION=
PROTECTED_DATA_LOOKUP_KEYS=
