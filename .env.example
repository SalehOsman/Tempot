# ==============================================================================
# Tembot Platform Environment Variables
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
VITE_API_URL=http://localhost:4000

# PostgreSQL 16 ACID Database
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/tembot
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=tembot

# Redis 7 Cache, Pub/Sub & BullMQ Queues
REDIS_URL=redis://localhost:6379

# MinIO / S3 Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword
MINIO_BUCKET=tembot-media
MINIO_USE_SSL=false

# Telegram Bot & TMA Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# AI Gateway API Keys (Fast & Reasoning Tiers)
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
